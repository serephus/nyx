cabal-version:      3.0
name:               template
version:            0.1.0.0
synopsis:           project description
license:            LicenseRef-GLWT
license-file:       LICENSE
build-type:         Simple

common warnings
    ghc-options: -Wall

library
    import:           warnings
    hs-source-dirs:   src
    exposed-modules:  Lib
    build-depends:    base
    default-language: Haskell2010

executable template
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base
                    , template
    default-language: Haskell2010

test-suite template-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test
    build-depends:    base
                    , template
    default-language: Haskell2010
